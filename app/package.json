{
  "name": "electron-vite-app-template",
  "version": "1.0.0",
  "main": "./out/main/index.mjs",
  "description": "Reusable Electron + Vite + React + TypeScript desktop application template",
  "private": true,
  "author": "Joseph Adogeri",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:portable": "npm run build && electron-builder --win dir",
    "build:installer": "npm run build && electron-builder --win nsis",
    "build:win": "npm run build && electron-builder --win nsis dir",
    "build:mac": "npm run build && electron-builder --mac dmg zip",
    "build:linux": "npm run build && electron-builder --linux AppImage deb",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.11",
    "electron-log": "^5.4.0",
    "electron-store": "^10.0.0",
    "zod": "^3.24.0",
    "react-router-dom": "^7.1.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.0",
    "autoprefixer": "^10.4.20"
  },
  "build": {
    "appId": "com.josephadogeridev.electronapp",
    "productName": "Electron Vite App Template",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "publish": [{ "provider": "github", "owner": "jadogeri", "repo": "Electron-Vite-App-Template", "releaseType": "draft" }],
    "win": {
      "icon": "resources/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        "dir"
      ]
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
