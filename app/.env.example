# Only VITE_* variables are exposed to renderer code. Never put secrets there.
VITE_APP_TITLE=Electron Starter
# Read in the main process through import.meta.env.MAIN_VITE_*
MAIN_VITE_LOG_LEVEL=info

# Optional integrations: runtime main-process environment ONLY.
# Electron does not expose these through VITE_* or renderer IPC.
# Public OIDC client (never a client secret):
# ELECTRON_OIDC_ISSUER=https://identity.example.com
# ELECTRON_OIDC_CLIENT_ID=desktop-public-client
# ELECTRON_OIDC_SCOPES=openid
# Callback: electron-vite-template://auth/callback
#
# Offline queue backend (no requests unless configured):
# APP_SYNC_BASE_URL=https://sync.example.com/api/
#
# Telemetry also requires explicit in-app consent; absent DSN remains disabled:
# SENTRY_DSN=<configure in your private runtime environment>
#
# Signing inputs belong in CI Secrets; see documentation/features/code-signing.md.
