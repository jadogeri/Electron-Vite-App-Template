{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "tests/**/*", "playwright.config.ts"]
}
